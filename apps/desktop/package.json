{
  "name": "@sori/desktop",
  "version": "0.1.0",
  "description": "Local-first Korean immersion desktop app",
  "author": "Sori contributors",
  "desktopName": "Sori",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,green \"npm:dev:vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.7",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wait-on": "^9.5.1"
  }
}
