#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"

command="${1:-build}"
if (( $# > 0 )); then
    shift
fi

case "$command" in
    build|run)
        if [[ "$command" == run && $# -gt 0 ]]; then
            echo "Usage: ./scripts/dev run" >&2
            exit 2
        fi
        cmake --preset dev
        cmake --build --preset dev --parallel
        if [[ "$command" == run ]]; then
            exec "$project_dir/build/development/sori"
        fi
        ;;
    test)
        cmake --preset dev
        cmake --build --preset dev --parallel --target sori-bridge-test
        ctest --preset dev "$@"
        ;;
    release)
        cmake --preset release
        cmake --build --preset release --parallel "$@"
        ;;
    appimage)
        exec "$project_dir/scripts/appimage" "$@"
        ;;
    *)
        echo "Usage: ./scripts/dev {build|run|test|release|appimage}" >&2
        exit 2
        ;;
esac
