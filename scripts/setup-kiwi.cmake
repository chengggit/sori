cmake_minimum_required(VERSION 3.21)

set(version "0.24.0")
if(NOT DEFINED KIWI_DESTINATION)
    get_filename_component(KIWI_DESTINATION "${CMAKE_CURRENT_LIST_DIR}/../resources/kiwi" ABSOLUTE)
endif()
cmake_host_system_information(RESULT architecture QUERY OS_PLATFORM)
string(TOLOWER "${architecture}" architecture)
if(architecture MATCHES "^(x86_64|amd64)$")
    set(architecture "x64")
elseif(architecture MATCHES "^(aarch64|arm64)$")
    set(architecture "arm64")
endif()

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(platform "linux")
    set(library_name "libkiwi.so")
    set(extension "tgz")
    if(architecture STREQUAL "x64")
        set(archive_platform "lnx_x86_64")
        set(library_hash "577768800258154da5fe6665081c73dafd6a0c39c8e091325d2b2bef8b5fb5d8")
    elseif(architecture STREQUAL "arm64")
        set(archive_platform "lnx_aarch64")
        set(library_hash "431fafce1bafc7bf5a4abcf7d306321df47cb4daabb9e8e16d40bb528a432fac")
    endif()
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(platform "darwin")
    set(library_name "libkiwi.dylib")
    set(extension "tgz")
    if(architecture STREQUAL "x64")
        set(archive_platform "mac_x86_64")
        set(library_hash "98d64a1fd7acd409bb4b26889fa67355ed569e8be3568f731c3f3e27eb45a5f6")
    elseif(architecture STREQUAL "arm64")
        set(archive_platform "mac_arm64")
        set(library_hash "87eda17f319c371824d5a2cc2e497eda6327ba3ddbf08a018db967f61ddbe48d")
    endif()
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    set(platform "win32")
    set(library_name "kiwi.dll")
    set(extension "zip")
    if(architecture STREQUAL "x64")
        set(archive_platform "win_x64")
        set(library_hash "d876d04cfff71dd4042f6964e1b950378fcb306234ac0258c4020cd23d9c4204")
    endif()
endif()
if(NOT DEFINED archive_platform)
    message(FATAL_ERROR "Kiwi setup does not support ${CMAKE_HOST_SYSTEM_NAME}-${architecture}.")
endif()
set(target "${platform}-${architecture}")
file(MAKE_DIRECTORY "${KIWI_DESTINATION}")
# Serialize setup runs so downloads and the readiness marker stay consistent.
file(LOCK "${KIWI_DESTINATION}/setup.lock" GUARD PROCESS TIMEOUT 300)

foreach(name Kiwi kiwi-rs)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/../assets/kiwi/${name}-LICENSE"
        "${KIWI_DESTINATION}/LICENSE-${name}" COPYONLY)
endforeach()

set(marker "${KIWI_DESTINATION}/ready.json")
if(EXISTS "${marker}")
    file(READ "${marker}" ready)
    string(JSON ready_version ERROR_VARIABLE version_error GET "${ready}" version)
    string(JSON ready_target ERROR_VARIABLE target_error GET "${ready}" target)
    if(NOT version_error AND NOT target_error
            AND ready_version STREQUAL version AND ready_target STREQUAL target
            AND EXISTS "${KIWI_DESTINATION}/lib/${library_name}"
            AND EXISTS "${KIWI_DESTINATION}/models/cong/base/sj.morph"
            AND EXISTS "${KIWI_DESTINATION}/models/cong/base/cong.mdl")
        message(STATUS "Kiwi ${version} resources already prepared for ${target}.")
        return()
    endif()
endif()

if(DEFINED SORI_ALLOW_DOWNLOADS AND NOT SORI_ALLOW_DOWNLOADS)
    message(FATAL_ERROR "Kiwi resources are missing or outdated. Enable SORI_ALLOW_DOWNLOADS or supply prepared resources with SORI_KIWI_DIR and SORI_PREPARE_KIWI=OFF.")
endif()

set(staging "${KIWI_DESTINATION}/.setup")
file(REMOVE_RECURSE "${staging}")
file(MAKE_DIRECTORY "${staging}")

function(download name expected_hash output)
    set(url "https://github.com/bab2min/Kiwi/releases/download/v${version}/${name}")
    set(archive "${staging}/${name}")
    message(STATUS "Downloading ${name}")
    file(DOWNLOAD "${url}" "${archive}" STATUS status
        TLS_VERIFY ON TIMEOUT 600 INACTIVITY_TIMEOUT 60)
    list(GET status 0 code)
    list(GET status 1 detail)
    if(NOT code EQUAL 0)
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "Download failed for ${name}: ${detail}")
    endif()
    file(SHA256 "${archive}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "Checksum mismatch for ${name}.")
    endif()
    set(extraction "${archive}-extracted")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extraction}")
    set("${output}" "${extraction}" PARENT_SCOPE)
endfunction()

download("kiwi_${archive_platform}_v${version}.${extension}" "${library_hash}" native)
download("kiwi_model_v${version}_base.tgz"
    "33188ba932bba4717bad5244bbec0ef8b1c9cbb47e26e68394a7976d8d779083" model)

# Verify the payload before replacing existing resources.
foreach(path "${native}/lib/${library_name}" "${model}/models/cong/base/sj.morph"
        "${model}/models/cong/base/cong.mdl")
    if(NOT EXISTS "${path}")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "Kiwi archive is missing ${path}.")
    endif()
endforeach()
file(REMOVE "${marker}")
file(MAKE_DIRECTORY "${KIWI_DESTINATION}/lib")
file(COPY "${native}/lib/${library_name}" DESTINATION "${KIWI_DESTINATION}/lib"
    FOLLOW_SYMLINK_CHAIN)
file(COPY "${model}/models" DESTINATION "${KIWI_DESTINATION}")
file(WRITE "${marker}.tmp" "{\n  \"version\": \"${version}\",\n  \"target\": \"${target}\"\n}\n")
file(RENAME "${marker}.tmp" "${marker}")
file(REMOVE_RECURSE "${staging}")
message(STATUS "Prepared Kiwi ${version} for ${target} in ${KIWI_DESTINATION}")
