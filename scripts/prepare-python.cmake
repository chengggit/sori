cmake_minimum_required(VERSION 3.21)
# Run only during a build, never while configuring or refreshing an editor.
file(LOCK "${ENV_DIR}.lock" GUARD PROCESS TIMEOUT 300)
if(WIN32)
    set(python "${ENV_DIR}/Scripts/python.exe")
else()
    set(python "${ENV_DIR}/bin/python")
endif()
file(SHA256 "${REQUIREMENTS}" build_hash)
file(SHA256 "${RUNTIME_REQUIREMENTS}" runtime_hash)
set(fingerprint "${BASE_PYTHON};${build_hash};${runtime_hash}")
set(marker "${ENV_DIR}/sori-ready.txt")
if(EXISTS "${marker}" AND EXISTS "${python}")
    file(READ "${marker}" previous)
    if(previous STREQUAL fingerprint)
        return()
    endif()
endif()
if(NOT ALLOW_DOWNLOADS)
    message(FATAL_ERROR "Caption environment is not prepared. Enable SORI_ALLOW_DOWNLOADS or supply SORI_HELPER_PYTHON with the required packages.")
endif()
execute_process(COMMAND "${BASE_PYTHON}" -m venv "${ENV_DIR}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot create caption environment. Install Python venv support or set SORI_HELPER_PYTHON.")
endif()
execute_process(COMMAND "${python}" -m pip install --disable-pip-version-check -r "${REQUIREMENTS}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Caption dependency installation failed. Check network access and retry the build.")
endif()
file(WRITE "${marker}" "${fingerprint}")
