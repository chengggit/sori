cmake_minimum_required(VERSION 3.21)
if(NOT CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Packages require Release. Configure with -DCMAKE_BUILD_TYPE=Release (or build --config Release).")
endif()
if(NOT BUNDLE_HELPER)
    message(FATAL_ERROR "Packages require SORI_BUNDLE_TRANSCRIPT_HELPER=ON. Reconfigure and retry.")
endif()
get_filename_component(qt_bin "${QMAKE}" DIRECTORY)
get_filename_component(qt_root "${qt_bin}" DIRECTORY)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    find_program(shell bash REQUIRED)
    set(command "${shell}" "${SOURCE_DIR}/scripts/appimage")
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    find_program(shell bash REQUIRED)
    set(command "${shell}" "${SOURCE_DIR}/scripts/ci/package-macos.sh")
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    find_program(shell NAMES pwsh powershell REQUIRED)
    set(command "${shell}" -NoProfile -File "${SOURCE_DIR}/scripts/ci/package-windows.ps1")
else()
    message(FATAL_ERROR "Packaging is unsupported on ${CMAKE_HOST_SYSTEM_NAME}.")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "SORI_BUILD_DIR=${BUILD_DIR}" "QMAKE=${QMAKE}" "QT_ROOT_DIR=${qt_root}"
    "MPV_ROOT=${MPV_ROOT}" ${command}
    WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Packaging failed; see the tool output above.")
endif()
