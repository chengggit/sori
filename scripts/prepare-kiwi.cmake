cmake_minimum_required(VERSION 3.21)
if(SORI_PREPARE_KIWI)
    set(KIWI_DESTINATION "${SORI_KIWI_DIR}")
    include("${CMAKE_CURRENT_LIST_DIR}/setup-kiwi.cmake")
else()
    foreach(path "lib/${KIWI_LIBRARY}" "models/cong/base/sj.morph" "models/cong/base/cong.mdl")
        if(NOT EXISTS "${SORI_KIWI_DIR}/${path}")
            message(FATAL_ERROR "Missing Kiwi resource: ${SORI_KIWI_DIR}/${path}. Enable SORI_PREPARE_KIWI and downloads, or supply a complete SORI_KIWI_DIR.")
        endif()
    endforeach()
endif()
