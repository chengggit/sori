{
  "name": "sori",
  "version": "0.1.0",
  "description": "An open-source, local-first Korean language immersion app",
  "type": "module",
  "scripts": {
    "setup:kiwi": "node scripts/setup-kiwi.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write src src-tauri/src package.json README.md *.json *.js",
    "format:check": "prettier --check src src-tauri/src package.json README.md *.json *.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:styles",
    "check:styles": "node scripts/check-tailwind-classes.mjs",
    "tauri": "tauri"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@get-air/video": "0.2.0",
    "@get-air/video-tauri": "0.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.70.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "bits-ui": "^2.20.6",
    "cn": "^0.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
