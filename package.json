{
  "name": "sori-workspace",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "desktop:native": "node scripts/build-native.mjs",
    "desktop:native:release": "node scripts/build-native.mjs --release",
    "desktop:dev": "npm run desktop:native && npm run dev -w @sori/desktop",
    "desktop:dev:vite": "npm run dev:vite -w @sori/desktop",
    "desktop:build": "npm run build -w @sori/desktop",
    "desktop:typecheck": "npm run typecheck -w @sori/desktop",
    "desktop:test:core": "cargo test --manifest-path crates/Cargo.toml",
    "desktop:test:native": "node scripts/smoke-native.mjs",
    "desktop:test:unit": "npm run test:unit -w @sori/desktop",
    "desktop:test:e2e": "npm run test:e2e -w @sori/desktop",
    "desktop:package": "npm run desktop:native:release && npm run package -w @sori/desktop"
  }
}
