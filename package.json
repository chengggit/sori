{
  "name": "sori",
  "version": "0.1.0",
  "description": "Local-first Korean immersion desktop app",
  "author": "Sori contributors",
  "desktopName": "Sori",
  "private": true,
  "type": "module",
  "main": "electron/main/index.cjs",
  "scripts": {
    "dev": "npm run native && npm run dev:electron",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run native:release && npm run build && electron-builder",
    "test:electron": "node --test tests/electron/*.test.cjs",
    "native": "node scripts/build-native.mjs",
    "native:release": "node scripts/build-native.mjs --release",
    "dev:electron": "concurrently -k -n vite,electron -c cyan,green \"npm:dev:vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "test:core": "cargo test --manifest-path crates/Cargo.toml",
    "test:native": "node scripts/smoke-native.mjs",
    "test:persistence": "node scripts/smoke-persistence.mjs",
    "test:migration": "node scripts/smoke-migration.mjs",
    "checksums": "node scripts/checksums.mjs",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"*.{json,js,ts,md}\" \"electron/**/*.cjs\" \"tests/{electron,smoke}/**/*.cjs\" \"scripts/**/*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"*.{json,js,ts,md}\" \"electron/**/*.cjs\" \"tests/{electron,smoke}/**/*.cjs\" \"scripts/**/*.mjs\" \"*.md\"",
    "test:http-bridge": "node scripts/smoke-http-bridge.mjs"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.82.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "concurrently": "^10.0.7",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "shadcn-svelte": "^1.8.2",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wait-on": "^9.5.1"
  }
}
